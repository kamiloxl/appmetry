{
  "name": "appmetry",
  "version": "0.1.0",
  "description": "appmetry SDK for Expo apps: offline event queue, sessions and install attribution",
  "author": "appmetry contributors",
  "main": "build/index.js",
  "module": "build/index.mjs",
  "types": "build/index.d.ts",
  "react-native": "build/index.js",
  "exports": {
    ".": {
      "react-native": "./build/index.js",
      "import": {
        "types": "./build/index.d.mts",
        "default": "./build/index.mjs"
      },
      "require": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "ios",
    "android",
    "!android/build",
    "!android/.gradle",
    "expo-module.config.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf build",
    "prepare": "tsup",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "react-native",
    "expo",
    "analytics",
    "attribution",
    "AppmetryAttribution"
  ],
  "repository": "https://github.com/kamiloxl/appmetry",
  "bugs": {
    "url": "https://github.com/kamiloxl/appmetry/issues"
  },
  "homepage": "https://github.com/kamiloxl/appmetry#readme",
  "license": "FSL-1.1-MIT",
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "*",
    "expo": "*",
    "expo-application": "*",
    "expo-crypto": "*",
    "expo-device": "*",
    "expo-linking": "*",
    "expo-localization": "*",
    "expo-router": "*",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@appmetry/shared": "workspace:*",
    "@babel/core": "^7.26.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native/jest-preset": "0.88.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "babel-preset-expo": "~58.0.22",
    "expo": "~58.0.23",
    "expo-application": "~58.1.2",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.14",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-test-renderer": "19.3.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "peerDependenciesMeta": {
    "expo-router": {
      "optional": true
    }
  }
}
