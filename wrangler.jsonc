{
  // The repository root is the deployable unit, so the Deploy to Cloudflare button works (spec §2 "Deployment").
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "appdash",
  "main": "apps/server/src/index.ts",
  "compatibility_date": "2026-11-05",
  "observability": { "enabled": true },
  "assets": {
    "directory": "apps/dashboard/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only the API and tracked links run the Worker; the dashboard is served as free static files.
    "run_worker_first": ["/api/*", "/l/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "appdash",
      // Placeholder: the Deploy to Cloudflare button provisions a database and replaces this id.
      // Deploying by hand? Run `npx wrangler d1 create appdash` and paste the id here.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "apps/server/migrations"
    }
  ],
  // Ingestion rate limit: 120 requests per 60 s per key (IP + app key).
  "ratelimits": [
    {
      "name": "INGEST_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "triggers": { "crons": ["0 3 * * *"] }
}
